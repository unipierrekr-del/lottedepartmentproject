/* ════════════════════════════════
   서비스 안내 섹션
   ════════════════════════════════ */
#guide { padding:0; background:#fff; border-bottom:1px solid #e8e8e8; }

/* 탭 네비 */
.guide-tab-nav {
  position:sticky; top:56px; z-index:200;
  background:#fff; border-bottom:1px solid #e8e8e8;
  display:flex; overflow-x:auto; scroll-snap-type:x mandatory;
  -webkit-overflow-scrolling:touch;
}
.guide-tab-nav::-webkit-scrollbar { display:none; }
.gtab {
  flex-shrink:0; padding:16px 28px;
  font-size:12px; font-weight:700; letter-spacing:0.04em;
  color:#aaa; background:none; border:none; border-bottom:2px solid transparent;
  transition:all .2s; cursor:pointer; white-space:nowrap; font-family:inherit;
  scroll-snap-align:start;
}
.gtab.active { color:#111; border-bottom-color:#111; }
.gtab:hover:not(.active) { color:#555; }

/* 각 섹션 */
.guide-section { display:none; }
.guide-section.active { display:block; }

/* 히어로 배너 (섹션 상단) */
.guide-banner {
  padding:80px 40px 0;
  max-width:1200px; margin:0 auto;
  display:grid; grid-template-columns:1fr 1fr;
  gap:60px; align-items:center; min-height:380px;
}
.guide-banner.reverse { direction:rtl; }
.guide-banner.reverse > * { direction:ltr; }
.gb-text { }
.gb-step {
  font-size:10px; letter-spacing:0.2em; text-transform:uppercase;
  color:#aaa; margin-bottom:14px; font-weight:700;
}
.gb-step span { color:#111; }
.gb-title {
  font-size:clamp(22px,3vw,36px); font-weight:700;
  letter-spacing:-0.02em; line-height:1.2; color:#111;
  margin-bottom:18px;
}
.gb-desc {
  font-size:13px; color:#666; line-height:1.85; font-weight:300;
}
.gb-desc strong { color:#111; font-weight:700; }
.gb-visual {
  position:relative; display:flex; align-items:center; justify-content:center;
  min-height:280px;
}

/* 모의 UI 카드 */
.mock-card {
  background:#fff; border:1px solid #e8e8e8;
  padding:20px; border-radius:4px;
  box-shadow:0 4px 24px rgba(0,0,0,.06), 0 1px 4px rgba(0,0,0,.04);
  width:100%; max-width:360px;
}
.mock-card-header {
  display:flex; align-items:center; justify-content:space-between;
  padding-bottom:14px; margin-bottom:14px; border-bottom:1px solid #f0f0f0;
}
.mock-card-title { font-size:12px; font-weight:700; color:#111; }
.mock-badge {
  font-size:9px; letter-spacing:0.1em; text-transform:uppercase;
  padding:3px 8px; background:#111; color:#fff;
}
.mock-badge.green { background:#2a7a4f; }
.mock-badge.blue { background:#2B4EAE; color:#fff; }
.mock-row {
  display:flex; justify-content:space-between; align-items:center;
  padding:9px 0; border-bottom:1px solid #f5f5f5;
}
.mock-row:last-child { border-bottom:none; }
.mock-row-label { font-size:11px; color:#888; }
.mock-row-val { font-size:11px; font-weight:700; color:#111; }
.mock-row-val.highlight { color:#2a7a4f; }
.mock-stat-grid {
  display:grid; grid-template-columns:1fr 1fr; gap:1px;
  background:#e8e8e8; margin-bottom:14px;
}
.mock-stat {
  background:#fafafa; padding:12px 14px;
}
.mock-stat-label { font-size:9px; color:#aaa; letter-spacing:0.1em; text-transform:uppercase; margin-bottom:4px; }
.mock-stat-val { font-size:16px; font-weight:700; color:#111; }
.mock-stat-val.lg { font-size:20px; }
.mock-chip-row { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
.mock-chip {
  font-size:10px; padding:4px 10px; border:1px solid #e8e8e8;
  color:#666; background:#fff;
}
.mock-chip.sel { background:#111; color:#fff; border-color:#111; }
.mock-progress { margin:12px 0; }
.mock-progress-bar {
  height:4px; background:#f0f0f0; margin-top:6px;
  position:relative; overflow:hidden;
}
.mock-progress-fill {
  height:100%; background:#111; width:0%;
  transition:width 1.2s ease;
}
.mock-timeline {
  display:flex; align-items:center; gap:0; margin-top:12px;
}
.mock-tl-step {
  flex:1; text-align:center; position:relative;
}
.mock-tl-dot {
  width:22px; height:22px; border-radius:50%; border:2px solid #e8e8e8;
  background:#fff; display:flex; align-items:center; justify-content:center;
  margin:0 auto 6px; font-size:9px; color:#aaa;
}
.mock-tl-dot.done { background:#111; border-color:#111; color:#fff; }
.mock-tl-dot.active { border-color:#111; }
.mock-tl-line {
  position:absolute; top:10px; left:calc(50% + 11px); right:calc(-50% + 11px);
  height:1px; background:#e8e8e8;
}
.mock-tl-label { font-size:9px; color:#aaa; letter-spacing:0.04em; }
.mock-tl-step.done .mock-tl-label { color:#111; font-weight:700; }

/* 패키지 비교 mock */
.mock-pkg-row {
  display:grid; grid-template-columns:repeat(3,1fr);
  gap:1px; background:#e8e8e8; margin-bottom:8px;
}
.mock-pkg-col {
  background:#fff; padding:12px 10px; text-align:center;
}
.mock-pkg-col.featured { background:#111; }
.mock-pkg-tier { font-size:8px; letter-spacing:0.15em; text-transform:uppercase; color:#aaa; margin-bottom:4px; }
.mock-pkg-col.featured .mock-pkg-tier { color:rgba(255,255,255,.5); }
.mock-pkg-price { font-size:13px; font-weight:700; color:#111; }
.mock-pkg-col.featured .mock-pkg-price { color:#fff; }

/* 기능 목록 */
.guide-features {
  max-width:1200px; margin:0 auto;
  padding:60px 40px 80px;
}
.guide-features-title {
  font-size:14px; font-weight:700; letter-spacing:0.06em;
  color:#111; margin-bottom:28px;
  padding-bottom:16px; border-bottom:1px solid #e8e8e8;
}
.guide-feat-grid {
  display:grid; grid-template-columns:repeat(3,1fr);
  gap:1px; background:#e8e8e8; margin-bottom:40px;
}
.guide-feat-card {
  background:#fff; padding:28px 24px;
  transition:background .2s;
}
.guide-feat-card:hover { background:#fafafa; }
.gfc-num {
  font-size:10px; letter-spacing:0.15em; text-transform:uppercase;
  color:#bbb; margin-bottom:12px;
}
.gfc-title { font-size:14px; font-weight:700; color:#111; margin-bottom:8px; line-height:1.4; }
.gfc-desc { font-size:12px; color:#888; line-height:1.75; }

/* 체험 신청 박스 */
.guide-cta-box {
  background:#111; padding:40px 44px;
  display:flex; align-items:center; justify-content:space-between;
  gap:24px; flex-wrap:wrap; max-width:1200px; margin:0 auto;
}
.gcta-title { font-size:18px; font-weight:700; color:#fff; margin-bottom:6px; letter-spacing:-0.01em; }
.gcta-desc { font-size:12px; color:#888; font-weight:300; }
.gcta-form { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
.gcta-input {
  border:1px solid rgba(255,255,255,.15); background:rgba(255,255,255,.06);
  color:#fff; padding:11px 16px; font-size:12px; font-family:inherit;
  width:220px; transition:border .2s;
}
.gcta-input::placeholder { color:rgba(255,255,255,.3); }
.gcta-input:focus { outline:none; border-color:rgba(255,255,255,.4); }
.gcta-btn {
  background:#fff; color:#111; border:none; padding:11px 22px;
  font-size:12px; font-weight:700; letter-spacing:0.06em; transition:background .2s;
}
.gcta-btn:hover { background:#e0e0e0; }

/* 반응형 */
@media(max-width:1024px) {
  .guide-banner { grid-template-columns:1fr; min-height:auto; }
  .guide-banner.reverse { direction:ltr; }
  .gb-visual { min-height:200px; }
  .guide-feat-grid { grid-template-columns:1fr 1fr; }
}
@media(max-width:768px) {
  .guide-banner, .guide-features { padding-left:20px; padding-right:20px; }
  .gtab { padding:14px 18px; font-size:11px; }
  .guide-feat-grid { grid-template-columns:1fr; }
  .guide-cta-box { padding:28px 20px; flex-direction:column; align-items:flex-start; }
  .gcta-form { width:100%; }
  .gcta-input { width:100%; }
  .mock-pkg-row { display:none; }
}


